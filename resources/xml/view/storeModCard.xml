<!--
    StoreModCard - 商店模组卡片组件
    左侧图标 + 右侧文本（名称、胶囊标签、统计数据）
-->

<brls:Box
    width="auto"
    height="auto"
    axis="row"
    alignItems="center"
    focusable="true"
    paddingTop="17"
    paddingBottom="17"
    paddingLeft="20"
    paddingRight="20"
    backgroundColor="@theme/app/cardBg"
    cornerRadius="10"
    highlightCornerRadius="10"
    shadowType="generic">

    <!-- 左侧：mod 图标 -->
    <brls:Image
        id="storeModCard/icon"
        width="88"
        height="88"
        marginRight="20"
        scalingType="fit"
        cornerRadius="8" />

    <!-- 右侧：文本区域 -->
    <brls:Box
        width="auto"
        height="92"
        axis="column"
        justifyContent="spaceEvenly"
        grow="1"
        clipsToBounds="true">

        <!-- mod 名称 + 已下载标识 -->
        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center"
            marginRight="15"
            marginBottom="2">

            <brls:Label
                id="storeModCard/name"
                width="auto"
                height="auto"
                fontSize="21"
                singleLine="true"
                shrink="1" />

            <brls:Box
                width="20"
                height="20"
                marginLeft="15"
                marginBottom="2"
                shrink="0">

                <brls:Image
                    id="storeModCard/installedIcon"
                    image="@res/img/mod/installed.png"
                    width="20"
                    height="20"
                    visibility="invisible" />

                <brls:Box
                    id="storeModCard/updateBadge"
                    width="6"
                    height="6"
                    cornerRadius="3"
                    backgroundColor="@theme/app/textWarning"
                    positionType="absolute"
                    positionTop="-4"
                    positionRight="-4"
                    visibility="invisible"/>
            </brls:Box>
        </brls:Box>

        <!-- 胶囊标签区域（限一行，溢出裁剪） -->
        <brls:Box
            id="storeModCard/tagRow"
            width="auto"
            height="auto"
            axis="row"
            clipsToBounds="true"
            marginBottom="2">

            <CapsuleBadge
                id="storeModCard/tagType"
                paddingTop="4"
                paddingBottom="4"
                paddingLeft="10"
                paddingRight="10"
                marginRight="8">

                <brls:Label
                    id="storeModCard/tagTypeText"
                    width="auto"
                    height="auto"
                    fontSize="15"
                    singleLine="true"/>

            </CapsuleBadge>

            <CapsuleBadge
                id="storeModCard/tagGameVersion"
                paddingTop="4"
                paddingBottom="4"
                paddingLeft="10"
                paddingRight="10"
                marginRight="6">

                <brls:Label
                    id="storeModCard/tagGameVersionText"
                    width="auto"
                    height="auto"
                    fontSize="15"
                    singleLine="true"/>

            </CapsuleBadge>

        </brls:Box>

        <!-- 统计数据（图标+数字） -->
        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center">

            <brls:Image id="storeModCard/iconLike" width="15" height="15" marginRight="7" />
            <brls:Label id="storeModCard/statLike" width="auto" height="auto" fontSize="15" textColor="@theme/app/textSecondary" singleLine="true" marginRight="27" />

            <brls:Image id="storeModCard/iconDislike" width="15" height="15" marginRight="7" />
            <brls:Label id="storeModCard/statDislike" width="auto" height="auto" fontSize="15" textColor="@theme/app/textSecondary" singleLine="true" marginRight="27" />

            <brls:Image id="storeModCard/iconDownload" width="15" height="15" marginRight="7" />
            <brls:Label id="storeModCard/statDownload" width="auto" height="auto" fontSize="15" textColor="@theme/app/textSecondary" singleLine="true" />

            <brls:Box width="auto" height="1" grow="1" />

            <brls:Image id="storeModCard/iconTime" width="15" height="15" marginRight="7" />
            <brls:Label id="storeModCard/statTime" width="auto" height="auto" fontSize="15" textColor="@theme/app/textSecondary" singleLine="true" />

        </brls:Box>

    </brls:Box>

</brls:Box>
