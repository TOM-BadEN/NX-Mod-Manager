<!--
    Search - 搜索页面布局

    页面只包含搜索结果和虚拟键盘。标题、索引与按键提示由全局 Shell 显示。
-->

<brls:Box
    width="100%"
    height="100%"
    axis="column">

    <!-- 搜索结果区域 -->
    <brls:Box
        id="search/results"
        width="auto"
        height="auto"
        grow="1"
        axis="column"
        justifyContent="center"
        alignItems="center"
        paddingLeft="40"
        paddingRight="40"
        paddingBottom="15">

        <brls:Label
            id="search/hint"
            width="auto"
            height="auto"
            text="@i18n/page/search/hintIdle"
            textColor="@theme/app/textSecondary"
            fontSize="24"/>

        <ResultButtonGrid
            id="search/buttonContainer"
            axis="column"
            alignItems="flexStart"
            visibility="gone"/>

    </brls:Box>

    <!-- 键盘区域背景只属于当前 Page，不覆盖全局底部栏 -->
    <brls:Box
        width="100%"
        height="auto"
        axis="column"
        alignItems="center"
        paddingBottom="5"
        backgroundColor="@theme/app/keyboardBg">

        <Keyboard
            id="search/keyboard"
            width="100%"
            paddingLeft="40"
            paddingRight="40"/>

    </brls:Box>

</brls:Box>
