<!--
    帮助页面布局
    左侧 RecyclingGrid（单列标题列表） + 右侧说明内容
-->

<brls:Box
    id="help/content"
    width="100%"
    height="100%"
    axis="row">

    <!-- 左侧：帮助条目列表 -->
    <RecyclingGrid
        id="help/grid"
        width="25%"
        height="100%"
        spanCount="1"
        itemHeight="70"
        itemSpace="18"/>

    <!-- 右侧：说明内容卡片 -->
    <brls:Box
        id="help/detail"
        width="auto"
        height="auto"
        grow="1"
        axis="column"
        focusable="true"
        marginTop="5"
        marginBottom="5"
        marginLeft="0"
        marginRight="40"
        paddingTop="40"
        paddingBottom="40"
        paddingLeft="40"
        paddingRight="40"
        backgroundColor="@theme/app/cardBg"
        cornerRadius="8"
        highlightCornerRadius="8"
        shadowType="generic">

        <!-- 内容区（动态填充） -->
        <brls:ScrollingFrame
            id="help/scroll"
            width="auto"
            grow="1"
            marginRight="-32">

            <brls:Box
                id="help/container"
                width="100%"
                height="auto"
                axis="column"
                paddingRight="44"/>

        </brls:ScrollingFrame>

        <!-- 底部滚动提示遮罩（覆盖完整卡片宽度） -->
        <ScrollHint
            id="help/scrollHint"
            height="104"
            positionType="absolute"
            positionBottom="0"
            positionLeft="0"
            positionRight="0"/>

    </brls:Box>

</brls:Box>
