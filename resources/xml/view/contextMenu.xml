<!--
    上下文菜单布局文件
-->

<brls:Box width="auto" height="auto" axis="row">
    <brls:Box
        id="contextMenu/left"
        width="auto"
        height="auto"
        grow="1"
        axis="column"
        justifyContent="flexStart"
        alignItems="flexEnd"
        paddingTop="87"
        paddingRight="18">
        <brls:Box
            id="contextMenu/hintCard"
            width="50%"
            height="auto"
            minHeight="30%"
            axis="column"
            shadowType="generic"
            paddingTop="30"
            paddingBottom="30"
            paddingLeft="30"
            paddingRight="30"
            backgroundColor="@theme/app/menuBg"
            cornerRadius="10">
            <brls:Label
                id="contextMenu/hintTitle"
                width="auto"
                height="auto"
                fontSize="21"/>
            <brls:Label
                id="contextMenu/hint"
                width="auto"
                height="auto"
                fontSize="21"
                marginTop="21"/>
        </brls:Box>
    </brls:Box>
    <brls:Box
        id="contextMenu/panel"
        width="37%"
        height="auto"
        axis="column"
        backgroundColor="@theme/app/menuBg"
        shadowType="generic">
        <brls:Box
            width="auto"
            height="@style/brls/applet_frame/header_height"
            axis="row"
            justifyContent="spaceBetween"
            alignItems="center"
            paddingLeft="@style/brls/applet_frame/header_padding_sides"
            paddingRight="@style/brls/applet_frame/header_padding_sides">
            <CapsuleBadge
                width="auto"
                height="56"
                shrink="1"
                axis="row"
                alignItems="center"
                paddingTop="0"
                paddingBottom="0"
                paddingLeft="24"
                paddingRight="24"
                cornerRadius="28"
                backgroundColor="@theme/app/shellCapsuleBg"
                borderColor="@theme/app/shellCapsuleBorder"
                borderThickness="1.5">
                <brls:Image
                    id="contextMenu/titleIcon"
                    width="32"
                    height="32"
                    marginRight="18"
                    shrink="0"
                    scalingType="fit"
                    visibility="gone"/>
                <brls:Label
                    id="contextMenu/title"
                    width="auto"
                    height="auto"
                    shrink="1"
                    fontSize="25"
                    singleLine="true"/>
            </CapsuleBadge>
            <brls:Label
                id="contextMenu/version"
                width="auto"
                height="auto"
                shrink="0"
                marginLeft="25"
                fontSize="19.5"
                textColor="@theme/app/textSecondary"
                singleLine="true"/>
        </brls:Box>
        <brls:Box
            width="auto"
            height="auto"
            grow="1">
            <RecyclingGrid
                id="contextMenu/grid"
                width="auto"
                height="auto"
                grow="1"
                marginRight="8"
                marginTop="3"
                marginBottom="3"
                spanCount="1"
                itemHeight="76"
                itemSpace="0"/>
        </brls:Box>
        <brls:Box
            width="auto"
            height="@style/brls/applet_frame/footer_height"
            axis="row"
            justifyContent="spaceBetween"
            alignItems="center"
            paddingLeft="@style/brls/hints/footer_padding_sides"
            paddingRight="@style/brls/hints/footer_padding_sides"
            paddingTop="@style/brls/hints/footer_padding_top_bottom"
            paddingBottom="@style/brls/hints/footer_padding_top_bottom"
            marginRight="@style/brls/applet_frame/padding_sides">
            <CapsuleBadge
                width="auto"
                height="46"
                axis="row"
                alignItems="center"
                paddingTop="0"
                paddingBottom="0"
                paddingLeft="18"
                paddingRight="18"
                cornerRadius="23"
                backgroundColor="@theme/app/shellCapsuleBg"
                borderColor="@theme/app/shellCapsuleBorder"
                borderThickness="1.5">
                <brls:Label
                    id="contextMenu/index"
                    width="auto"
                    height="auto"
                    fontSize="19.5"/>
            </CapsuleBadge>
            <CapsuleHints
                width="auto"
                height="auto"
                shrink="0"
                addBaseAction="false"/>
        </brls:Box>
    </brls:Box>
</brls:Box>
